# Postgres connection string (Neon). Use a READ-ONLY role for the app;
# the seed script needs an owner/writer URL.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Owner connection used ONLY by `npm run seed`. Must be a different role from
# DATABASE_URL above — never add this one to Vercel. The deployed app should hold
# no credential capable of writing, so the SQL guard is not the only line of
# defence. See docs/milestone-0-skeleton-live.md for the role setup.
DATABASE_URL_OWNER="postgres://owner:password@host/dbname?sslmode=require"

# LLM provider: "google" (default) or "groq"
LLM_PROVIDER="google"
# Optional model override, e.g. "gemini-3.5-flash" or "llama-3.3-70b-versatile"
# LLM_MODEL="gemini-3.5-flash"

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Or, if LLM_PROVIDER=groq — https://console.groq.com/keys
# GROQ_API_KEY=""

# Optional: eval gate (0..1). CI sets this; locally you can leave it unset.
# EVAL_THRESHOLD=0.8
